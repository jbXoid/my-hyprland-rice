# Take a look at the mako manpage with the command:
#   man 5 mako
# To view all configuration options.

font="Jetbrains Mono" 11
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
anchor=top-center
background-color=#161616
width=300
height=75
margin=5
padding=0,5,10
border-size=2
border-color=#efefef
border-radius=15
icons=0
max-icon-size=64
default-timeout=2500
ignore-timeout=1

[urgency=normal]
border-color=#ef6464

[urgency=high]
border-color=#ef324b
default-timeout=0


[app-name=lightcord summary~="(.*(^| )orz|ORZ|sto|STO|otl|OTL( |$).*)"]
invisible=1
