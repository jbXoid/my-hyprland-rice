{
	"layer": "top",
    	"height": 55,
    	"modules-left": ["cpu","custom/sep","memory"],
    	"modules-center": ["clock"],
    	"modules-right": ["tray", "pulseaudio", "custom/sep","network", "custom/sep","battery","custom/battery-sep","hyprland/language"],

   	"custom/sep": {
		   "format": "|"
   	},
    	"hyprland/workspaces": {
        	"format": "{name}",
        	"on-click": "activate"
    	},
    	"clock": {
        	"format": "{:%H:%M:%S %d.%m.%Y}",
		"interval": 0
    	},
    	"pulseaudio": {
        	"format": "{volume}% {icon}",
        	"format-icons": ["", "", ""]
    	},
    	"network": {
        	"format-wifi": "  {essid}",
	        "format-ethernet": "󰈀",
        	"format-disconnected": "⚠"
	},
    	"tray": {
        	"spacing": 10
    	},
    
    "custom/battery-sep": {
      "exec": "~/.config/waybar/scripts/battery-sep.sh",
      "interval": 30,
      "format": "{}"
    },


	"battery": {
		"states": { "warning": 30, "critical": 15 },
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-icons": ["", "", "", "", ""],
		"tooltip": true,
		"interval": 1
	},

    "hyprland/language": {
        "format": "  {short}",
    },

	"cpu": {
		"id":"cpu",
		"format": " {usage}% ",
		"states": { "warning": 50, "critical": 75  },
		"interval": 1
	  },

	"memory": {
		"id": "memory",
		"format": "  {percentage}%",
		"states": { "warning": 50, "critical": 75  },
		"interval": 1
	  }
}
